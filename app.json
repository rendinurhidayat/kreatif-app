{
  "expo": {
    "name": "Jobsly",
    "slug": "kreatif-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ongstoree.kreatif"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ongstoree.kreatif"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Jobsly",
      "shortName": "Jobsly",
      "lang": "id",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C10"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jobsly memakai foto untuk gambar profil.",
          "cameraPermission": "Jobsly memakai kamera untuk foto profil."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "jobsly"
  }
}
